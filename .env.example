# Never commit actual values. Add these in Netlify Project configuration > Environment variables.
# Jobber OAuth app credentials. The callback must be:
# https://tuffbrosdetailing.com/.netlify/functions/jobber-oauth-callback
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=https://tuffbrosdetailing.com/.netlify/functions/jobber-oauth-callback
JOBBER_GRAPHQL_VERSION=2025-04-16
# A separate long random value used only to start the owner-only OAuth connection.
JOBBER_CONNECT_TOKEN=

# 32+ random bytes, encoded as a long base64 or hexadecimal value.
BOOKING_SESSION_SECRET=

# Keep false until the Jobber app is authorized and schedule queries are verified.
JOBBER_BOOKING_READY=false
